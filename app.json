{
  "expo": {
    "name": "Crasenim Pharma",
    "slug": "crasenim-pharma",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/crasenim-app-icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.crasenimpharma.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/crasenim-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/crasenim-app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e8b9c89f-7d88-4975-b1c4-8e405a8fb2fc"
      }
    }
  }
}
